{
  "name": "convene",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "seed": "tsx --env-file=.env.local scripts/seed.ts",
    "worker": "node --env-file=.env.local scripts/match-worker.mjs",
    "format": "prettier --write src scripts tests next.config.ts package.json tsconfig.json README.md IMPLEMENTATION.md",
    "format:check": "prettier --check src scripts tests next.config.ts package.json tsconfig.json README.md IMPLEMENTATION.md"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.0",
    "lucide-react": "1.47.0",
    "next": "16.3.6",
    "openai": "7.22.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@tailwindcss/postcss": "4.3.3",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "sharp": "0.34.5",
    "@electric-sql/pglite": "0.5.8",
    "@electric-sql/pglite-pgvector": "0.0.9",
    "prettier": "3.6.2"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.19.0"
}
